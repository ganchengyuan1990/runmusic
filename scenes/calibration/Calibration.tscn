[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/CalibrationScene.gd" id="1_cal_scene"]
[ext_resource type="Script" path="res://scripts/ui/CalibrationUI.gd" id="2_cal_ui"]

[node name="Calibration" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_cal_scene")

[node name="CalibrationUI" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("2_cal_ui")

[node name="VBox" type="VBoxContainer" parent="CalibrationUI"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -240.0
offset_top = -170.0
offset_right = 240.0
offset_bottom = 170.0
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="CalibrationUI/VBox"]
layout_mode = 2
text = "音频校准"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="CalibrationUI/VBox"]
layout_mode = 2
text = "感觉鼓点偏晚 → 增大偏移；偏早 → 减小"
horizontal_alignment = 1
autowrap_mode = 2

[node name="OffsetLabel" type="Label" parent="CalibrationUI/VBox"]
layout_mode = 2
text = "偏移：0 ms"
horizontal_alignment = 1

[node name="OffsetSlider" type="HSlider" parent="CalibrationUI/VBox"]
layout_mode = 2
min_value = -200.0
max_value = 200.0
step = 1.0

[node name="TapButton" type="Button" parent="CalibrationUI/VBox"]
layout_mode = 2
text = "听拍校准"

[node name="TapStatus" type="Label" parent="CalibrationUI/VBox"]
layout_mode = 2
text = "点「听拍校准」，跟着嘀声按空格或再点按钮。"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Buttons" type="HBoxContainer" parent="CalibrationUI/VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 16

[node name="SkipButton" type="Button" parent="CalibrationUI/VBox/Buttons"]
layout_mode = 2
text = "跳过"

[node name="ContinueButton" type="Button" parent="CalibrationUI/VBox/Buttons"]
layout_mode = 2
text = "继续"
